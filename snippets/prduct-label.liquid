{%- assign labels = product.metafields.custom.labels.value -%}

{% if labels != blank %}
  <div class="product-labels">
    {% for label in labels %}
      {%- assign background_color = label.color -%}
      {%- assign color_string = "" | append: background_color -%}
      {%- assign txt_color = color_string | color_lighten: 100 -%}

      <small
        class="product-label"
        style="background-color: {{ background_color }}; color: {{ txt_color }};">
        {{ label.title }}
      </small>
    {% endfor %}
  </div>
{% endif %}