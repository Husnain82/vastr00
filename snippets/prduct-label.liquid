{%- assign labels = product.metafields.custom.labels.value -%}

{% if labels != blank %}
  <div class="product-labels">
    {% for label in labels %}
      {% assign background_color = label.color %}
      {% assign txt_color = label.title_color %}
      {% assign text_color = background_color | color_lighten: 100 %}

      <small
        class="product-label"
        style="background-color: {{ background_color }}; color: {{ txt_color }};">
        {{ label.title }}
      </small>
    {% endfor %}
  </div>
{% endif %}